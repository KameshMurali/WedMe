DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedme"
AUTH_SECRET="replace-with-a-long-random-secret"
# Local development URL. In production on Vercel, set APP_URL="https://wed.tonewbeginning.com"
APP_URL="http://localhost:3000"
# Use STORAGE_DRIVER="blob" on Vercel for signed client uploads.
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="public/uploads"
BLOB_READ_WRITE_TOKEN=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ToNewBeginning.com <noreply@tonewbeginning.com>"
EMAIL_DELIVERY_MODE="console"
# AI content drafting (Together/Forever). Leave ANTHROPIC_API_KEY blank to ship
# dark — the "Draft with AI" buttons stay hidden and nothing breaks.
ANTHROPIC_API_KEY=""
# Optional overrides — defaults: claude-haiku-4-5-20251001 and 20 attempts/user/day.
AI_DRAFT_MODEL=""
AI_DRAFT_DAILY_LIMIT=""
