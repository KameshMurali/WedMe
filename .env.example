DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedme"
AUTH_SECRET="replace-with-a-long-random-secret"
# Local development URL. In production on Vercel, set APP_URL="https://wed.tonewbeginning.com"
APP_URL="http://localhost:3000"
# Use STORAGE_DRIVER="blob" on Vercel for signed client uploads.
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="public/uploads"
BLOB_READ_WRITE_TOKEN=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ToNewBeginning.com <noreply@tonewbeginning.com>"
EMAIL_DELIVERY_MODE="console"
# AI content drafting (Together/Forever). Leave ANTHROPIC_API_KEY blank to ship
# dark — the "Draft with AI" buttons stay hidden and nothing breaks.
ANTHROPIC_API_KEY=""
# Optional overrides — defaults: claude-haiku-4-5-20251001 and 20 attempts/user/day.
AI_DRAFT_MODEL=""
AI_DRAFT_DAILY_LIMIT=""

# --- Paddle checkout (Merchant of Record) -----------------------------------
# Leave ALL of these blank to keep checkout off: the pricing page then shows the
# waitlist capture exactly as before. Checkout switches on automatically once
# the client token and both price IDs are set (see checkoutEnabled in pricing.ts).
# Public values (inlined into the client bundle):
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_ENV="sandbox"          # "sandbox" | "production"
NEXT_PUBLIC_PADDLE_PRICE_TOGETHER=""      # pri_... for the Together plan
NEXT_PUBLIC_PADDLE_PRICE_FOREVER=""       # pri_... for the Forever plan
NEXT_PUBLIC_PADDLE_DISCOUNT_LAUNCH=""     # dsc_... 30% off Forever, launch offer
# Server-only secrets (never exposed to the browser):
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""                  # required — the webhook rejects everything without it

# Require couples to confirm their email before signing in.
# Leave blank/false. Before setting this to true you MUST run:
#   npm run backfill-verified -- --apply
# Verification has never been enforced, so no existing couple has clicked their
# link; turning this on first would lock every one of them out.
REQUIRE_EMAIL_VERIFICATION=""
